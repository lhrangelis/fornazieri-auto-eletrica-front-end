---
import Brand from './Brand.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import ExternalHint from './ExternalHint.astro';
import { business, fullAddress, telLink, waLink } from '../data/business';
import { groupedHours } from '../lib/hours';

const year = new Date().getFullYear();
const columns = [
  { title: 'Elétrica', items: ['Diagnóstico de motor', 'Injeção eletrônica', 'Bateria', 'Alternadores'] },
  { title: 'Conforto', items: ['Ar-condicionado', 'Janelas elétricas', 'Alarmes', 'Fechaduras'] },
];
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <Brand />
        <p>Elétrica completa para carros, motos e caminhões em {business.address.city}/{business.address.state}. Instalação de som automotivo e iluminação.</p>
        <address>{fullAddress}</address>
      </div>
      {
        columns.map((c) => (
          <nav aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>
              {c.items.map((i) => (
                <li>
                  <a href="#servicos">{i}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <div>
        <h2>Atendimento</h2>
        <ul>
          {groupedHours().map((g) => <li>{g.label} · {g.hours}</li>)}
          <li><a href={telLink} data-track="phone">{business.phone.display}</a></li>
          <li>
            <a href={business.instagram.url} target="_blank" rel="noopener" data-track="instagram">Instagram<ExternalHint /></a>
          </li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {year} {business.legalName} · CNPJ {business.cnpj}</span>
      <span>Auto Elétrica · Som Automotivo</span>
    </div>
  </div>
</footer>

<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Chamar no WhatsApp (abre em nova aba)" data-track="whatsapp">
  <WhatsAppIcon size={30} />
</a>

<style>
  footer {
    background: #060607;
    border-top: 1px solid var(--line);
    padding: 64px 0 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }
  .foot > * {
    min-width: 0;
  }
  .foot :global(.brand) {
    margin-bottom: 16px;
  }
  address {
    font-style: normal;
    margin-top: 12px;
  }
  h2 {
    font-family: var(--head);
    font-size: 16px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 16px;
  }
  ul {
    display: grid;
    gap: 10px;
  }
  a:hover {
    color: #fff;
  }
  .copy {
    border-top: 1px solid var(--line);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .wa-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 60;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 12px 30px -8px rgba(37, 211, 102, 0.6);
    transition: transform 0.2s;
  }
  .wa-float:hover {
    transform: scale(1.06);
    color: #fff;
  }
  @media (max-width: 920px) {
    .foot {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .foot {
      grid-template-columns: 1fr;
    }
    .wa-float {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
