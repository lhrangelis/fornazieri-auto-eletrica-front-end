---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size, class: cls } = Astro.props;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---

<svg class:list={['i', cls]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" style={style} set:html={icons[name]} />
